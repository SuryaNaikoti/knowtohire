# KNOWTOHIRE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or service-role keys to version control.

# Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for browser/frontend client)
# WARNING: NEVER use the service_role key here. Frontend apps must ONLY use the anon key.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ====================================================================
# CASHFREE PAYMENT GATEWAY (FUTURE INTEGRATION PHASE)
# ====================================================================
# Target API Version: 2025-01-01
# Cashfree environment: 'sandbox' (testing) or 'production' (live)
#
# CRITICAL SECURITY WARNING:
# Cashfree credentials are SECRET server-side credentials.
# NEVER prefix CASHFREE_CLIENT_SECRET with VITE_ or expose to the frontend.
# Authenticated Cashfree API calls must occur exclusively in server-side contexts.

# Cashfree Environment: 'sandbox' | 'production'
CASHFREE_ENVIRONMENT=sandbox

# Cashfree App ID / Client ID (Server-Side)
CASHFREE_CLIENT_ID=your_cashfree_app_id_here

# Cashfree Secret Key (STRICTLY SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key_here

# Cashfree API Version
CASHFREE_API_VERSION=2025-01-01
